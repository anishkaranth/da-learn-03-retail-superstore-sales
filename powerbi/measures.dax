// measures.dax - DAX measures for the Superstore star schema (create in a "_Measures" table)
// Same definitions as sql/04_analysis.sql.

Total Sales = SUM ( fact_sales[sales] )
Total Profit = SUM ( fact_sales[profit] )
Profit Margin % = DIVIDE ( [Total Profit], [Total Sales] )
Order Lines = COUNTROWS ( fact_sales )
Orders = DISTINCTCOUNT ( fact_sales[order_id] )
Customers = DISTINCTCOUNT ( fact_sales[customer_key] )
Units = SUM ( fact_sales[quantity] )
Avg Order Value = DIVIDE ( [Total Sales], [Orders] )
Avg Discount % = AVERAGE ( fact_sales[discount] )
Loss Lines = CALCULATE ( COUNTROWS ( fact_sales ), fact_sales[is_loss_line] = 1 )
Loss Line % = DIVIDE ( [Loss Lines], [Order Lines] )
Profit Lost On Loss Lines = - CALCULATE ( SUM ( fact_sales[profit] ), fact_sales[profit] < 0 )
Returned Orders = CALCULATE ( DISTINCTCOUNT ( fact_sales[order_id] ), fact_sales[returned_flag] = 1 )
Order Return Rate % = DIVIDE ( [Returned Orders], [Orders] )
Returned Sales = CALCULATE ( [Total Sales], fact_sales[returned_flag] = 1 )
Avg Ship Days = AVERAGE ( fact_sales[ship_days] )
Sales Share % = DIVIDE ( [Total Sales], CALCULATE ( [Total Sales], ALL ( dim_geography ) ) )

Sales PY = CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( dim_date[full_date] ) )
Sales YoY % = DIVIDE ( [Total Sales] - [Sales PY], [Sales PY] )
Profit PY = CALCULATE ( [Total Profit], SAMEPERIODLASTYEAR ( dim_date[full_date] ) )
Profit YoY % = DIVIDE ( [Total Profit] - [Profit PY], [Profit PY] )

Discounted Line % = DIVIDE ( CALCULATE ( COUNTROWS ( fact_sales ), fact_sales[discount] > 0 ), [Order Lines] )
Margin At Zero Discount % = CALCULATE ( [Profit Margin %], fact_sales[discount] = 0 )
Margin Above 20pct Discount % = CALCULATE ( [Profit Margin %], fact_sales[discount] > 0.2 )
